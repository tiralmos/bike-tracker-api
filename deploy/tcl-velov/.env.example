# Copy this file to deploy/tcl-velov/.env and fill it in.
# Keep the single quotes: they stop special characters in your password
# from being interpreted.
#
# You can copy GRANDLYON_CREDENTIALS and GRANDLYON_BASIC_AUTH from
# deploy/lyon/.env if you already set that one up.

# Your data.grandlyon.com login, as email:password.
# Used by gtfsrt-tcl to read the SIRI-Lite real-time feed.
GRANDLYON_CREDENTIALS='you@example.com:your-password'

# The same email:password, base64-encoded on a single line.
# Used by the API to download the TCL GTFS timetable ZIP.
GRANDLYON_BASIC_AUTH='eW91QGV4YW1wbGUuY29tOnlvdXItcGFzc3dvcmQ='

# The Vélo'v data is open: it needs no account.

# Your computer's address on your home network, e.g. 192.168.1.10.
# The display connects to the API at this address.
HOST_IP=192.168.1.10

# Port the API is published on, on your computer (3001 if unset).
API_PORT=3001

# Optional: public address of the API, e.g. behind a Cloudflare Tunnel.
# When set, the configurator suggests it instead of http://HOST_IP:API_PORT.
# API_PUBLIC_URL=https://transit-tracker.example.com

# Optional: folders of the other repositories, if not cloned next to this one
# with their default names.
# GTFSRT_TCL_DIR=../../../gtfsrt-tcl
# CONFIGURATOR_DIR=../../../transit-tracker-lyon-configurator

# Optional: port of the configurator on this computer (8080 if unset).
# CONFIGURATOR_PORT=8080
