# Your computer's address on your home network, e.g. 192.168.1.10.
# The display connects to the API at this address. See
# docs/deployment/deploy-velov.md, step 2, to find it.
HOST_IP=192.168.1.10

# Port the API is published on, on your computer. Change it if another
# program already uses it. The display and the configurator use this port too.
API_PORT=3001
