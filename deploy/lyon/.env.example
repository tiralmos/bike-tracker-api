# Copy this file to deploy/lyon/.env and fill in both values.
# Keep the single quotes: they stop special characters in your password
# from being interpreted.

# Your data.grandlyon.com login, as email:password.
# Used by gtfsrt-tcl to read the SIRI-Lite real-time feed.
GRANDLYON_CREDENTIALS='you@example.com:your-password'

# The same email:password, base64-encoded on a single line.
# Used by the API to download the TCL GTFS timetable ZIP.
GRANDLYON_BASIC_AUTH='eW91QGV4YW1wbGUuY29tOnlvdXItcGFzc3dvcmQ='
